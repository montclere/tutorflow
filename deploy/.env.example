# Локальный PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Локальная настройка API аккаунтов. Значения пустых полей задайте в окружении запуска API.
IDENTITY_DATABASE_URL=
IDENTITY_SECRET=
IDENTITY_LOCAL_MAILPIT=1
IDENTITY_SECURE_COOKIE=0
IDENTITY_MAILPIT_PORT=1025
IDENTITY_MAILPIT_UI_PORT=8025

# Bearer-токен точки /metrics. Пустое значение закрывает доступ.
TUTORFLOW_METRICS_TOKEN=
# Общий постоянный каталог снимков API и обслуживания.
# При пустом значении переменную не экспортировать, используется .artifacts/metrics.
TUTORFLOW_METRICS_DIRECTORY=

# Таймаут сетевой доставки в секундах.
IDENTITY_DELIVERY_TIMEOUT_SECONDS=8
# Необязательные переопределения политик. Периоды задаются в ISO 8601.
# IDENTITY_POLICY__CODE_LIFETIME=PT10M
# IDENTITY_POLICY__CODE_ATTEMPTS=5
# IDENTITY_POLICY__LOGIN_IP__ATTEMPTS=60
# IDENTITY_POLICY__LOGIN_IP__PERIOD=PT10M

# Ограничение Argon2 в экземпляре API. При нескольких workers лимиты и память суммируются.
IDENTITY_ARGON_MAX_CONCURRENT=2
IDENTITY_ARGON_WAIT_TIMEOUT_SECONDS=1
IDENTITY_ARGON_MEMORY_KIB=19456
IDENTITY_ARGON_TIME_COST=2
IDENTITY_ARGON_PARALLELISM=1

# Максимальный размер тела HTTP-запроса в байтах до разбора JSON.
TUTORFLOW_HTTP_MAX_REQUEST_BODY_BYTES=65536
